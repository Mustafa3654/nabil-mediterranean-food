RewriteEngine On

# 1. Force www (Always redirect non-www to www)
RewriteCond %{HTTP_HOST} ^nabilmediterraneanfood\.com [NC]
RewriteRule ^(.*)$ https://www.nabilmediterraneanfood.com/$1 [R=301,L]

# 2. Hide .php extensions
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# 3. Block direct access to includes directory
RewriteRule ^includes/ - [F,L]

# 4. Security Headers for Admin
<IfModule mod_headers.c>
    SetEnvIf Request_URI "^/admin" IS_ADMIN
    Header set X-Robots-Tag "noindex, nofollow" env=IS_ADMIN
</IfModule>
